{
  "openapi": "3.1.0",
  "info": {
    "title": "TickerTrace - Institutional ETF Activity API",
    "description": "Real-time institutional ETF holdings data. Track daily position changes, cross-fund signals, sector flow, and option activity across ARK Invest, Avantis, Kurv, YieldMax, REX Shares, and more.\n\n**What you get:**\n- Daily holdings changes for 20+ actively-managed ETFs\n- Cross-fund divergence signals (same ticker, opposite directions)\n- Sector rotation flow analysis\n- Option writing activity tracking\n- Historical holdings data\n\n**Use cases:**\n- Quantitative research & alpha generation\n- Portfolio construction signals\n- Institutional flow monitoring\n- Alternative data feeds\n\n**Rate limits:**\n- Free: 100 requests/day\n- Pro ($15/mo): 5,000 requests/day\n- Institutional ($50/mo): 50,000 requests/day",
    "version": "1.1.0",
    "contact": {
      "name": "TickerTrace",
      "url": "https://tickertrace.pro",
      "email": "mphanko@gmail.com"
    },
    "x-logo": {
      "url": "https://tickertrace.pro/favicon.ico"
    }
  },
  "paths": {
    "/api/v1/signals": {
      "get": {
        "summary": "Get Signals",
        "description": "Full signal payload including institutional buying/selling signals, pre-market briefing, sector flow, and divergences. Free tier — no API key needed.",
        "operationId": "get_signals_api_v1_signals_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "Data"
        ]
      }
    },
    "/api/v1/stats": {
      "get": {
        "summary": "Get Stats",
        "description": "Global stats: total funds tracked, total underlyings, put/call ratio. Free tier.",
        "operationId": "get_stats_api_v1_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "Data"
        ]
      }
    },
    "/api/v1/sectors": {
      "get": {
        "summary": "Get Sector Flow",
        "description": "Sector-level weight changes across all tracked funds. Shows money flowing in and out by sector.",
        "operationId": "get_sectors_api_v1_sectors_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "Data"
        ]
      }
    },
    "/api/v1/changes": {
      "get": {
        "summary": "Get Changes",
        "description": "All daily position changes. Filterable by provider, fund, direction.",
        "operationId": "get_changes_api_v1_changes_get",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Provider"
            },
            "description": "Filter by provider name (e.g. 'ARK Invest', 'Avantis')"
          },
          {
            "name": "fund",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fund"
            },
            "description": "Filter by fund ticker (e.g. 'ARKK', 'AVUV')"
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Direction"
            },
            "description": "Filter by direction: 'buy' or 'sell'"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            },
            "description": "Max number of results to return (1-200, default 50)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "Data"
        ]
      }
    },
    "/api/v1/fund/{fund}": {
      "get": {
        "summary": "Get Fund Detail",
        "description": "Fund holdings detail — top holdings, options count, daily changes for a specific fund.",
        "operationId": "get_fund_api_v1_fund__fund__get",
        "parameters": [
          {
            "name": "fund",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Fund"
            },
            "description": "Fund ticker (e.g. 'ARKK', 'AVUV', 'KYLD')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "Data"
        ]
      }
    },
    "/api/v1/ticker/{ticker}": {
      "get": {
        "summary": "Get Ticker Detail",
        "description": "Cross-fund ticker detail — which funds are buying or selling this ticker?",
        "operationId": "get_ticker_api_v1_ticker__ticker__get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            },
            "description": "Stock or ETF ticker symbol (e.g. 'AAPL', 'TSLA')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "Data"
        ]
      }
    },
    "/api/v1/divergences": {
      "get": {
        "summary": "Get Divergences",
        "description": "Cross-fund divergences — tickers where funds are moving in opposite directions (one buying, another selling).",
        "operationId": "get_divergences_api_v1_divergences_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "Data"
        ]
      }
    },
    "/api/v1/funds": {
      "get": {
        "summary": "List All Funds",
        "description": "List all tracked funds with their provider and AUM.",
        "operationId": "list_funds_api_v1_funds_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "Data"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tickertrace.mphinance.com",
      "description": "Production"
    }
  ]
}