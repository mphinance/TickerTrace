[Unit]
Description=TickerTrace API (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=mphinance
WorkingDirectory=/home/mphinance/TickerTrace
EnvironmentFile=/home/mphinance/TickerTrace/api/.env
ExecStart=/home/mphinance/TickerTrace/.venv/bin/uvicorn api.server:app --host 127.0.0.1 --port 8100 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
