# Whop app credentials. Get these from your app's page in the Whop dashboard
# at https://whop.com/dashboard.
NEXT_PUBLIC_WHOP_APP_ID=app_xxxxxxxxxxxxxxxx
WHOP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_WHOP_AGENT_USER_ID=user_xxxxxxxxxxxxxx

# Optional. Only needed if you're making admin-side calls scoped to a
# specific company (most experience-view code does not need this).
NEXT_PUBLIC_WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx

# TickerTrace public API. Defaults to the live prod endpoint — set to a
# local FastAPI when developing both halves at once.
NEXT_PUBLIC_API_URL=https://api.tickertrace.pro
