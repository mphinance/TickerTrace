# Next.js
etf-dashboard/.next/
etf-dashboard/node_modules/
etf-dashboard/.env*

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Data
# We include normalized_holdings.csv because the dashboard depends on it
# but we exclude the raw source files if they are large
*holdings.csv
!normalized_holdings.csv
!etf-dashboard/public/data/history/holdings_*.csv
*.html

# SQLite scratch DBs — these are rebuilt by the scraper. Committing the
# binary just bloats the repo and the API container uses its own DB
# at api/data/tickertrace.db (also gitignored).
data/holdings.db
data/*.db-journal
api/data/*.db
api/data/*.db-journal
scraper.log

# yfinance price cache used by the signal-performance backtest. Regenerated
# incrementally; multi-MB derived artifact. The aggregate output JSON it
# produces (etf-dashboard/public/data/signal_performance.json) IS committed.
data/signal_performance_prices.json

# System
.DS_Store
Thumbs.db

# Gemini Artifacts
.gemini/
.vercel
.env*.local
.venv/
.stripe_env
firebase-service-account.json

# Vultr / SSH credentials — never commit these
.env.vultr*
.ssh_keys/
.deploy_vultr.py
deploy_vultr.ps1
push_session.ps1

# Syncthing conflict files
*.sync-conflict-*

# Firebase debug logs
firebase-debug.log
